#!name = 通用抓包提取
#!desc = 按远程规则表抓取指定域名的 Cookie / 请求头 / 请求体 / 响应体 中的值，弹窗展示并可长按复制。规则表放远程仓库，改规则不用重装模块。
#!author = SuzukiRenz

[Argument]
# ===== 规则表地址（必填，可填多个，逗号分隔）=====
# 规则表是纯文本 conf，放公开仓库，改完小火箭自动同步
ruleURLs = https://raw.githubusercontent.com/SuzukiRenz/sr-capture/main/sr-capture-rules.conf, label=规则表地址(逗号分隔), keyboard=url

# ===== 冷却：同一条规则在这个秒数内只提示一次 =====
cooldown = 300, label=冷却秒数(默认300)

# ===== 调试：1=未命中也弹窗 =====
debug = 0, label=调试模式(0关1开)

[Script]
# 请求侧：能抓 request.cookie / request.header / request.body
sr-capture-req = type=http-request,pattern=^https?:\/\/,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/SuzukiRenz/sr-capture/main/sr-capture.js,timeout=60

# 响应侧：额外能抓 response.header / response.body
sr-capture-res = type=http-response,pattern=^https?:\/\/,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/SuzukiRenz/sr-capture/main/sr-capture.js,timeout=60

[MITM]
hostname = %APPEND% *
