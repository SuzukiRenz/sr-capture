#!name = 通用抓包提取
#!desc = 按远程规则表抓取指定域名的 Cookie / 请求头 / 请求体 / 响应体中的值，弹窗展示并可长按复制。规则表放远程仓库，改规则不用重装模块。
#!author = SuzukiRenz

[Argument]
# ===== 规则表地址（必填，可填多个，逗号分隔）=====
# 规则表是纯文本 conf，放公开仓库，改完小火箭自动同步
ruleURLs = https://raw.githubusercontent.com/SuzukiRenz/sr-capture/main/sr-capture-rules.conf, label=规则表地址(逗号分隔), keyboard=url

# ===== 冷却：同一条规则在这个秒数内只提示一次 =====
cooldown = 300, label=冷却秒数(默认300)

# ===== 调试：1=未命中也弹窗 =====
debug = 0, label=调试模式(0关1开)

[Script]
# 这里刻意用通配 pattern，不写死域名。
# 抓哪个域名、抓什么、用什么正则，全部由远程 rules.conf 决定 ——
# 这样加新站点只改 conf，不用重装模块，也不用在这里手动补域名。
#
# requires-body：请求侧设为 0，不读请求体，性能开销小；
# 规则里真需要 request.body 时，脚本自己能拿到（小火箭默认不预读，
# 需要时脚本侧仍可读 $request.body，绝大多数场景够用）。
sr-capture-req = type=http-request,pattern=^https?:\/\/,requires-body=0,max-size=0,script-path=https://raw.githubusercontent.com/SuzukiRenz/sr-capture/main/sr-capture.js,timeout=60

# 响应侧需要读 body 才能抓 response.body 规则，所以要 requires-body=1。
# max-size 给个上限，避免把大文件（视频、安装包）整个缓冲下来拖垮内存。
sr-capture-res = type=http-response,pattern=^https?:\/\/,requires-body=1,max-size=1048576,script-path=https://raw.githubusercontent.com/SuzukiRenz/sr-capture/main/sr-capture.js,timeout=60

# 解密所有域名。小火箭只会解密这里列出的域名，用 * 让远程规则表随意扩域名。
# 前提：证书已安装并信任、且 App 里 HTTPS 解密总开关已打开。
# 想缩小解密范围（省电/降风险），把下面这行改成具体域名列表即可，
# 但那样就得和 rules.conf 保持同步了。
[MITM]
hostname = %APPEND% *
