#!name = 通用抓包提取
#!desc = 按远程规则表抓取指定域名的 Cookie / 请求头 / 请求体 / 响应体中的值，弹窗展示并可长按复制。规则表放远程仓库，改规则不用重装模块。
#!author = SuzukiRenz

[Argument]
# ===== 规则表地址（必填，可填多个，逗号分隔）=====
# 规则表是纯文本 conf，放公开仓库，改完小火箭自动同步
ruleURLs = https://raw.githubusercontent.com/SuzukiRenz/sr-capture/main/sr-capture-rules.conf, label=规则表地址(逗号分隔), keyboard=url

# ===== 冷却：同一条规则在这个秒数内只提示一次 =====
cooldown = 300, label=冷却秒数(默认300)

# ===== 调试：1=未命中也弹窗 =====
debug = 0, label=调试模式(0关1开)

[Script]
# pattern 只匹配规则表里出现过的域名，不要用 .* 或 ^https?:// 全量匹配。
# 全量匹配 + requires-body=1 会让每个请求都触发脚本并缓冲响应体，
# 请求一多小火箭会跳过脚本执行，表现就是「模块完全没反应」。
# 加新域名时，同步改下面两个 pattern 和 [MITM] 的 hostname。
sr-capture-req = type=http-request,pattern=^https?:\/\/(waimai-guide\.ele\.me|tb\.ele\.me|mtop\.ele\.me|h\.app\.coc\.10086\.cn|client\.app\.coc\.10086\.cn|wx\.10086\.cn|jd\.com|meituan\.com)\/,requires-body=0,max-size=0,script-path=https://raw.githubusercontent.com/SuzukiRenz/sr-capture/main/sr-capture.js,timeout=60

# 响应侧：只有规则表里写了 response.body 才需要
sr-capture-res = type=http-response,pattern=^https?:\/\/(waimai-guide\.ele\.me|tb\.ele\.me|mtop\.ele\.me|client\.app\.coc\.10086\.cn|wx\.10086\.cn)\/,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/SuzukiRenz/sr-capture/main/sr-capture.js,timeout=60

[MITM]
hostname = %APPEND% waimai-guide.ele.me, tb.ele.me, mtop.ele.me, h.app.coc.10086.cn, client.app.coc.10086.cn, wx.10086.cn, jd.com, meituan.com
